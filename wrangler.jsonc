{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artbenchmark",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist"
  },
  "keep_vars": true,
  "routes": [
    { "pattern": "artbenchmark.org", "custom_domain": true },
    { "pattern": "www.artbenchmark.org", "custom_domain": true }
  ]
}
